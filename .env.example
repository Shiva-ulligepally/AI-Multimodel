# DocuMind AI - Vercel Monorepo Environment Variables

# Frontend API URL (defaults to /api for same-domain deployment)
VITE_API_URL=/api

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/documind

# AI APIs
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Cloudinary (File Storage - replaces local disk storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Environment
NODE_ENV=production

# CORS Origin(s) - comma-separated or wildcard
CORS_ORIGIN=*
