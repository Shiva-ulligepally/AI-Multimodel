# =========================================================================
# DocuMind AI Fullstack — Environment Variables Template
# Copy this file to '.env' and fill in your actual API keys.
# Never commit your active secrets into git!
# =========================================================================

# Database Configuration (Optional: defaults to ephemeral JSON mock in /tmp if blank)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/documind?retryWrites=true&w=majority

# Cloudinary Integration (Required for persistent file & image hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Models & Multi-modal Engines (Configure at least one for intelligence)
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Node Environment
NODE_ENV=development
PORT=5000
