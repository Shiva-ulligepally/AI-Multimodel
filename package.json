{
  "name": "ai-fullstack-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node backend/index.js",
    "client": "cd frontend && npm run dev"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cloudinary": "^1.40.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "officeparser": "^4.1.0",
    "openai": "^4.51.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
